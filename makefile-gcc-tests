#############################################################################
## GNU Makefile for building gcc-mcdc COTS testsuite


# Define the C compiler, linker and debugger
CC = gcc
LN = gcc

CFLAGS = -std=c17 -O0 -fprofile-arcs -ftest-coverage -fcondition-coverage
		 
TARGET = gccs_tests

SRCS = gcc_testsuite_gcov-19.c

###############################################################################
## Rule to make the specified TARGET
##
%.exe: %.o
	$(LN) $^ -o $*.exe

###############################################################################
##  "C" COMPILER RULE
##
%.o: %.c
	$(CC) -c $(CFLAGS) $<
	
##############################################################################
##
.PHONY: all clean run gcov

all: clean $(TARGET) run gcov

$(TARGET): $(OBJS) 
	$(CC) $(CFLAGS) -o $(TARGET) $(SRCS)
	
clean ::
	rm -f gccs_tests *.gcda *.gcno *.o

gcov ::
	gcov -abcdfg gcc_testsuite_gcov-19.c -o gccs_tests-gcc_testsuite_gcov-19 

run ::
	./$(TARGET)	
	