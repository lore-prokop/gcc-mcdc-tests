\satisfies   A-1 partial, cases 18-20/27

\fn          void mcdc003a (int a, int b)
\details     not statement -2 conditions, 2/4
\satisfies   B-4 partial, cases 1/3
\satisfies   A-1 partial, cases 21-23/27

\fn          void mcdc004a (int a)
\details     if - atomic, with else, 1/2
\satisfies   C-4 partial, cases 1/10

