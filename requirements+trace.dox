/* The 40 requirements for GCC MC/DC testing in doxygen form */

/**
\requirement	C-1	Basic Block - Single Statement	
				Verify that basic blocks in subprograms are correctly detected.
\requirement	C-2	Basic Block Multiple Statements		
				Verify that basic blocks forming a handled-sequence-of-statements in a function body are correctly detected.
\requirement	C-3	loop statements		
				Verify that loops are correctly handled.
\requirement	C-4	if-elseif-else statements	
				Verify that if statements are correctly handled, including variants such as if-else and if-elsif-else.
\requirement	C-5	switch statement	
				Verify that case statements are correctly handled.
\requirement	C-6	break statement		
				Verify that (apparent) basic blocks that do not complete execution because of a break statement are handled correctly.
\requirement	C-7	goto statement	
				Verify that (apparent) basic blocks that do not complete execution because of goto statements are handled correctly.
\requirement	C-8	return statement	
				Verify that (apparent) basic blocks that do not complete execution because of return statements are handled correctly.
\requirement	C-9	declarations generating executable code		
				Verify that declarations that generate executable code are included in statement coverage report.
\requirement	C-10	partial evaluation due to short circuit		
				Verify that partial evaluation of short-circuited expressions does not impact statement coverage.
\requirement	C-11	partial evaluation due to ternary operator	
				Verify that partial evaluation of conditional expressions does not impact statement coverage.
\requirement	C-12	basic block spanning multiple lines		
				Verify that a basic block spanning multiple lines is handled correctly.
\requirement	C-13	basic block spanning a single line	
				Verify that a basic block spanning a single line is handled correctly.
\requirement	C-14	multiple blocks on one line		
				Verify that multiple basic blocks on one line are handled correctly.
\requirement	C-15	source code indentation does not affect coverage	
				Verify that the coverage reported is not affected by source code indentation.
\requirement	C-16	compiler optimization effect on coverage - killed assignment		
				Verify killed assignment elimination is properly reflected with and without compiler optimization.
\requirement	C-17	compiler optimization effect on coverage - subexpression optimization		
				Verify that common subexpression optimization is properly reflected with and without compiler optimization.
\requirement	C-18	compiler optimization effect on coverage - loop invariant optimization	
				Verify that loop invariant optimization is reflected properly with and without compiler optimization.
\requirement	C-19	compiler optimization effect on coverage - dead code elimination	
				Verify that dead code elimination optimization does not impact coverage.
\requirement	C-20	inlining	
				Verify that function inlining does not impact coverage.
\requirement	B-1	Boolean variable references		
				Verify that Boolean variable references (local variable, global variable, parameter, array object, struct object) are handled correctly.
\requirement	B-2	Boolean function return value	
				Verify that calls to functions that return Boolean results are handled correctly.
\requirement	B-3	constant Boolean variable in conditional	
				Verify that constant Boolean values are handled correctly.
\requirement	B-4	unary not (!) operator	
				Verify that Boolean expressions containing the unary not operator are handled correctly.
\requirement	B-5	or (||) and and (&&) operators	
				Verify that Boolean expressions containing the binary operators and and or are handled correctly.
\requirement	B-6	relational operators	
				Verify that Boolean expressions containing relational operators (==, !=, >, <, >=, <=) are handled correctly.
\requirement	B-7	ternary "?:" operator	
				Verify that Boolean expressions containing the C ternary Boolean operator (A ? B : C) are handled correctly.
\requirement	B-8	Boolean expressions in assignment statements	
				Verify that Boolean expressions in  assignment statements are handled correctly.
\requirement	B-9	Boolean expressions in loop indices		
				Verify that Boolean for loop index variables are handled correctly.
\requirement	B-10	Boolean function call parameters	
				Verify that Boolean actual parameters are handled correctly.
\requirement	B-11	implicit return		
				Verify that an implicit return statement is handled correctly in coverage results.
\requirement	A-1	uncoupled Boolean conditions - relational operators &&, ||, !		
				Verify that uncoupled Boolean expressions containing operators and (&&), or (||), and not (!), each of which can be set independently of the others, are handled correctly.
\requirement	A-2	uncoupled Boolean conditions - logical operators	
				Verify that uncoupled Boolean expressions containing other binary operators, each of which can be set independently of the others, are handled correctly. Other binary operators are the following:  == (equal to), != (not equal to), > (greater than), < (less than), >= (greater than or equal to), and <= (less than or equal to). 
\requirement	A-3	uncoupled Boolean conditions - short circuiting		
				Verify that uncoupled Boolean expressions containing short-circuit operators, each of which can be set independently of the others, are handled correctly.
\requirement	A-4	coupled Boolean conditions   - relational operators &&, ||, !	
				Verify that coupled Boolean expressions containing operators and (&&), or (||), and not (!), each of which can be set independently of the others, are handled correctly.
\requirement	A-5	coupled Boolean conditions   - logical operators	
				Verify that coupled Boolean expressions containing other binary operators, each of which can be set independently of the others, are handled correctly. Other binary operators are the following:  == (equal to), != (not equal to), > (greater than), < (less than), >= (greater than or equal to), and <= (less than or equal to). 
\requirement	A-6	coupled Boolean conditions   - short circuiting		
				Verify that coupled Boolean expressions containing short-circuit operators, each of which can be set independently of the others, are handled correctly.
\requirement	A-7	large condition count handling	
				Verify that expressions with 64 conditions function properly, and a compiler warning is issued above 64.
\requirement	A-8	non-tree-like decision structures	
				Verify that non-tree-like decision tree structures are handled correctly.
\requirement	A-9	stress cases - complex multi-line conditions	
				Verify proper handling of a random assortment of multi-line conditions with multiple variables, parenthesis, and mixed operators.
*/

/* Below are the names, brief descriptions, and requirement traceability for  */
/* the GCC-owned test suite of functions. Documentation and traceability is   */
/* done here so as not to modify or alter the gcc-owned code in any way, but  */
/* also that it can be used to generate documentation and traceability info.  */

/**
\file 		gcc_testsuite_gcov-19.c
\brief      gcc-maintained tests as part of their open-source product
\details	This file is owned by gcc as part of its open-source product test
suite. It is available as 'gov-19.c' from:
[gcc.git] / gcc / testsuite / gcc.misc-tests / gcov-19.c.    The original file
has not been altered in any way, though to generate doxygen documentation of 
the code and traceability to the requirements in this package, function 
definitions and traceabilty information are contained in a separate file 
called 'requirements+trace.dox'.   

\fn          int id  (int x)
\details	 identity function, used as helper for function call
\satisfies   C-1 partial 1/2

\fn          void mcdc001a (int a, int b)
\details     or statement, 2 variables, 1/4 conditions
\satisfies   B-5 partial, cases 1/8
\satisfies   A-1 partial, cases 1-3/27

\fn          void mcdc001b (int a, int b)
\details     or statement, 2 variables, 3/4 conditions
\satisfies   B-5 partial, cases 2/8
\satisfies   A-1 partial, cases 4-5/27

\fn          void mcdc001c (int a, int b)
\details     or statement, 2 variables, 4/4 conditions
\satisfies   B-5 partial, cases 3/8
\satisfies   A-1 partial, cases 6/27

\fn          void mcdc001d (int a, int b, int c)
\details     or statement, 3 variables, 2/6 conditions
\satisfies   B-5 partial, cases 4/8
\satisfies   A-1 partial, cases 7-11/27

\fn          void mcdc002a (int a, int b)
\details     and statement - 2 variables, 1/4 conditions
\satisfies   B-5 partial, cases 5/8
\satisfies   A-1 partial, cases 12-14/27

\fn          void mcdc002b (int a, int b)
\details     and statement - 2 conditions, 3/4 conditions
