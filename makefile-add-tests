#############################################################################
## GNU Makefile for building gcc-mcdc COTS testsuite


# Define the C compiler, linker and debugger
CC = gcc
LN = gcc

CFLAGS = -std=c17 -Wstrict-prototypes -Wundef \
          -O0 -fprofile-arcs -ftest-coverage -fcondition-coverage
		 
TARGET = add_tests

SRCS = additional_gcc_testsuite.c

###############################################################################
## Rule to make the specified TARGET
##
%.exe: %.o
	$(LN) $^ -o $*.exe

###############################################################################
##  "C" COMPILER RULE
##
%.o: %.c
	$(CC) -c $(CFLAGS) $<
	
##############################################################################
##

.PHONY: all clean run gcov

all: clean $(TARGET) run gcov

$(TARGET): $(OBJS) 
	$(CC) $(CFLAGS) -o $(TARGET) $(SRCS)
	
clean ::
	rm -f add_tests rm -f *.gcda *.gcno *.o

gcov ::
	gcov -abcdfg additional_gcc_testsuite.c -o add_tests-additional_gcc_testsuite 

run ::
		./add_tests
